#include <iostream>
using namespace std;


void displayPatient(string namePatient, double agePatient,double timePatient, char category){
	cout<<"======Patient Detail======"<<"\n";
	cout<<"Patient name : "<< namePatient;
	cout<<"\nPatient age : "<< agePatient;
	cout<<"\nPatient arrive at : "<< timePatient<<"\n";
	cout<<"============================";

	switch (category){
	
		case 'e':
			cout<<"\nCategory is Emergency";
			cout<<"\nQueue is 1";
			cout<<"\nPriority = Highest"<<"\n";
			cout<<"============================";
		break;
		
		case 's':
			cout<<"\nCategory is Senior Citezen ";
			cout<<"\nQueue is 2";
			cout<<"\nPriority = Standard"<<"\n";
			cout<<"============================";
		break;
		
		case 'n':
			cout<<"\nCategory is normal ";
			cout<<"\nQueue is 3";	
			cout<<"\nPriority = Lowest"<<"\n";
			cout<<"============================";
			
		break;
		
		default:
			cout<<"INVALID";
		break;	
			
	}	
}

int main(){
	string name;
	double age, time;
	char category;
	int choice;
	
	do{
		cout<<endl;
	 	cout << "\n\n==============================";
        cout << "\n     PATIENT QUEUE SYSTEM";
        cout << "\n==============================";
        cout << "\n1. Enter Patient Details";
        cout << "\n2. Display Patient Details";
        cout << "\n3. Exit";
        cout << "\n==============================";

        cout << "\nEnter your choice : ";
        cin >> choice;
        cout<<"\n";
	

	switch(choice){
	
		case 1:
			
			cout<<"Enter detail of the patient "<<"\n";
	
			cout<<"\nEnter patient name : ";
			cin>>name;
	
			cout<<"Enter patient age : ";
			cin>>age;
	
			cout<<"Enter arrival time(24 HOUR FORMAT/0000) : ";
			cin>>time;
	
			cout<<"Enter patient category(e-Emergency/s-Senior Citizen/n-Normal) : ";
			cin>>category;
		break;
		
		case 2:
			displayPatient(name, age, time, category);	
		break;
		
		case 3:
			cout<<"\nThank you for using our system!";	
		break;
		
		default:
			cout<<"Please enter (1/2/3) only!";
		break;	
	}	
}
	while(choice!=3);

	return 0;

}
