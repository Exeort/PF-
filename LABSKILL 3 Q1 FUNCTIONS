#include <iostream>
using namespace std;


int number, numCount;
char choice;

void multiplication(){
	for(int i=0; i<numCount; i++)
	cout<<i<<" x "<<number<< " = "<<i*number<<"\n";
}


int main(){

do{

	cout<<"Enter number to multiply : ";
	cin>>number;
	cout<<"Enter how many number to multiply :";
	cin>>numCount;
	multiplication();
	cout<<"Want to continue (y-yes/n-no) :";
	cin>>choice;
	
  } while(choice == 'y');


return 0;	
}
